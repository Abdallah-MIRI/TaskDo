{
  "id": "/TaskDo/",
  "name": "TaskDo - Modern Multi-Storage Task Manager",
  "short_name": "TaskDo",
  "description": "A modern, extensible, offline-first task management application supporting Arabic and English, multiple storage providers, and clean project workflows.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/TaskDo/",
  "scope": "/TaskDo/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#f7f9f9",
  "theme_color": "#2a9d8f",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
